# WordPress core / secrets — jamais versionnés
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/*.log

# Identifiants notés localement — ne jamais versionner (dépôt public).
# Ancrés à la racine (/) pour ne pas exclure par erreur des fichiers d'extensions.
/*admin*.txt
/*identifiant*.txt
/*password*.txt
/*credentials*
/wordpress admin.txt

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dépendances du dépôt lui-même (racine uniquement).
# ATTENTION : ne PAS ignorer vendor/ ou node_modules/ à toute profondeur — les extensions
# WordPress embarquent leur propre vendor/ (autoload PHP) qui doit être déployé, sinon
# activation impossible (ex. Contact Form 7, Blocksy Companion).
/node_modules/
/vendor/

# Sauvegardes locales (racine uniquement — certaines extensions embarquent des .sql de schéma)
/*.sql
/*.zip
